{
  "name": "reactotron-plugin-mmkv",
  "version": "1.0.1",
  "description": "Full-featured Reactotron plugin for react-native-mmkv — operation logging + State tab integration",
  "main": "dist/commonjs/index.js",
  "module": "dist/module/index.js",
  "types": "dist/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "import": "./dist/module/index.js",
      "require": "./dist/commonjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:commonjs": "tsc --project tsconfig.build.json --module commonjs --outDir dist/commonjs",
    "build:module": "tsc --project tsconfig.build.json --module es2015 --outDir dist/module",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist/typescript",
    "build": "npm run clean && npm run build:commonjs && npm run build:module && npm run build:types",
    "clean": "rm -rf dist",
    "test": "jest --no-watchman",
    "test:watch": "jest --watch --no-watchman",
    "prepublishOnly": "npm run build && npm test",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "reactotron",
    "reactotron-plugin",
    "mmkv",
    "react-native-mmkv",
    "react-native",
    "debugging",
    "storage",
    "state-inspector",
    "developer-tools"
  ],
  "author": "Mohd Rehan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdRehan991/reactotron-plugin-mmkv.git"
  },
  "bugs": {
    "url": "https://github.com/mdRehan991/reactotron-plugin-mmkv/issues"
  },
  "homepage": "https://github.com/mdRehan991/reactotron-plugin-mmkv#readme",
  "peerDependencies": {
    "react-native": ">=0.74.0",
    "react-native-mmkv": ">=3.0.0",
    "reactotron-core-client": ">=2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "reactotron-core-client": "^2.9.5",
    "ts-jest": "^29.3.4",
    "typescript": "^5.9.3"
  }
}
